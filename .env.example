# ---- Required ----

# Get a free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Port the addon server listens on
PORT=7000

# Where the SQLite database file lives (created automatically)
DB_PATH=./data/tracker.db

# ---- Notifications (pick ONE) ----

# Option A: Telegram bot (recommended, free)
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Message your new bot once, then visit:
#    https://api.telegram.org/bot<token>/getUpdates
#    to find your chat id in the JSON response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B: ntfy.sh (no account needed, free)
# Pick any unique topic name, then subscribe to it in the ntfy app
NTFY_TOPIC=

# ---- Optional: AI recommendations ----
# https://platform.deepseek.com — pay-as-you-go, pennies per month at personal scale
DEEPSEEK_API_KEY=

# ---- Optional: multi-user mode ----
# If true, every user gets their own addon install URL + isolated data.
# If false (default), this instance tracks a single household/person.
MULTI_USER=false

# REQUIRED. This secret becomes part of your addon's install URL
# (https://yourdomain/SECRET/manifest.json) and is the only thing stopping
# a random person on the internet from finding and using your addon.
# Generate a real one — do NOT leave this as the placeholder:
#   openssl rand -hex 16
APP_SECRET=change-me-to-a-random-string

# ---- Free HTTPS domain (DuckDNS) ----
# Sign up free at https://www.duckdns.org (login with GitHub/Google), then
# create a subdomain, e.g. "jarvis-tracker" -> jarvis-tracker.duckdns.org
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
# Full domain, used by Caddy — should match DUCKDNS_SUBDOMAIN above
DUCKDNS_DOMAIN=yoursubdomain.duckdns.org
