#!/bin/sh
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
  deploy\ *) sha=${SSH_ORIGINAL_COMMAND#deploy } ;;
  *) echo 'Expected deploy followed by a commit SHA' >&2; exit 1 ;;
esac
case "$sha" in *[!0-9a-f]*|'') exit 1 ;; esac
[ "${#sha}" -eq 40 ] || exit 1
exec sudo -n /usr/local/sbin/stremio-deploy "$sha"
